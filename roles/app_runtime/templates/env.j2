# Géré par Ansible — rôle app_runtime. Ne pas modifier à la main.
NODE_ENV={{ app_node_env }}
PORT={{ app_port }}
LOG_LEVEL={{ app_log_level }}
MONGO_URI=mongodb://{{ mongodb_app_user }}:{{ vault_mongodb_app_password | urlencode }}@{{ mongodb_bind_ip }}:{{ mongodb_port }}/{{ mongodb_database }}?replicaSet={{ mongodb_replicaset }}&authSource={{ mongodb_database }}
JWT_SECRET={{ vault_jwt_secret }}
JWT_EXPIRES_IN={{ app_jwt_expires_in }}
JWT_REFRESH_EXPIRES_IN={{ app_jwt_refresh_expires_in }}
CORS_ORIGIN={{ app_cors_origin }}
BCRYPT_ROUNDS={{ app_bcrypt_rounds }}
