# Géré par Ansible — rôle web_proxy.
server {
    listen 80;
    server_name {{ web_proxy_server_name }};
    return 301 https://$host$request_uri;
}

server {
    # Ubuntu 24.04 (noble) fournit Nginx 1.24.0. La directive `http2 on;`
    # séparée n'existe qu'à partir de Nginx 1.25.1 : sur 1.24, elle est
    # inconnue et fait échouer `nginx -t`. On utilise donc ici l'ancienne
    # syntaxe `listen ... http2;`, seule prise en charge par cette version.
    listen 443 ssl http2;
    server_name {{ web_proxy_server_name }};

    ssl_certificate     {{ web_proxy_cert_path }};
    ssl_certificate_key {{ web_proxy_key_path }};
    ssl_protocols       TLSv1.2 TLSv1.3;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types application/json text/plain;

    location /health {
        proxy_pass http://127.0.0.1:{{ app_port }}/health;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
